# Production env vars for Render (set in Dashboard → Environment)
# Copy this as a reference; do NOT commit real values.

APP_NAME="Cafe System"
APP_ENV=production
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
APP_DEBUG=0
APP_URL=https://your-app-name.onrender.com
ASSET_URL=https://your-app-name.onrender.com

DB_CONNECTION=pgsql
# DATABASE_URL is set automatically by Render when you link a PostgreSQL database (Internal URL)

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

LOG_CHANNEL=stderr
LOG_LEVEL=warning

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
